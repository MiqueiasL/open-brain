<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Topo: Título e Status Rápido -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🧠 OpenBrain"
            android:textColor="#38BDF8"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_settings_ia"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:backgroundTint="#0284C7"
            android:text="⚙️ IA"
            android:textColor="#F8FAFC"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_toggle_hud"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:backgroundTint="#1E293B"
            android:text="🚀 Cápsula"
            android:textColor="#F8FAFC"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Barra de Conexão de Acessibilidade -->
    <Button
        android:id="@+id/btn_status_a11y"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="#334155"
        android:text="⚙️ Acessibilidade: Verificando..."
        android:textColor="#E2E8F0"
        android:textSize="12sp" />

    <!-- Área Central de Diálogo e Execução (Histórico com Rolagem) -->
    <ScrollView
        android:id="@+id/scroll_history"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:layout_weight="1"
        android:background="#1E293B"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/layout_chat_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🤖 JARVIS ONLINE\nPronto para executar ordens de voz ou texto.\n• Lanterna, volume, bateria, alarmes, timers.\n• Rotas no Waze e mensagens no WhatsApp.\n• Leitura e cliques de tela via Acessibilidade.\n• Comandos de terminal shell nativo."
                android:textColor="#94A3B8"
                android:textSize="13sp" />

        </LinearLayout>
    </ScrollView>

    <!-- Indicador de Escuta de Voz -->
    <TextView
        android:id="@+id/tv_voice_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:gravity="center"
        android:text="Toque no microfone para falar ou digite abaixo"
        android:textColor="#38BDF8"
        android:textSize="12sp" />

    <!-- Rodapé: Entrada de Comando e Microfone -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/et_command_input"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:background="#334155"
            android:hint="Diga ou digite um comando..."
            android:imeOptions="actionSend"
            android:inputType="text"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_voice_record"
            android:layout_width="54dp"
            android:layout_height="50dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#0284C7"
            android:text="🎙️"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btn_send_command"
            android:layout_width="54dp"
            android:layout_height="50dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="#38BDF8"
            android:text="▶"
            android:textColor="#0F172A"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
