<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🧠 OPENBRAIN"
            android:textColor="@color/accent"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Motor Autônomo e Assistente Soberano Android"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- Card de Status do Sistema -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STATUS DOS SUBSISTEMAS"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- 1. Acessibilidade -->
                <TextView
                    android:id="@+id/tv_status_a11y"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="• Acessibilidade: Verificando..."
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <!-- 2. Shizuku ADB -->
                <TextView
                    android:id="@+id/tv_status_shizuku"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="• Shizuku ADB: Verificando..."
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <!-- 3. Overlay Flutuante -->
                <TextView
                    android:id="@+id/tv_status_overlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="• Janela Flutuante (HUD): Verificando..."
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Botões de Ação & Permissões -->
        <Button
            android:id="@+id/btn_enable_a11y"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/card_bg"
            android:text="⚙️ Ativar Serviço de Acessibilidade"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/btn_req_shizuku"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/card_bg"
            android:text="⚡ Autorizar Shizuku (Wireless ADB)"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/btn_start_hud"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/accent"
            android:text="🚀 Iniciar HUD Flutuante (Cápsula)"
            android:textColor="@color/primary"
            android:textStyle="bold" />

        <!-- Card de Teste das Funções Básicas (Paridade Siri/Google) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="TESTE DE PARIDADE BÁSICA (SIRI / GOOGLE)"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_test_torch"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:backgroundTint="@color/card_bg"
                android:text="🔦 Lanterna"
                android:textColor="@color/text_primary" />

            <Button
                android:id="@+id/btn_test_battery"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:backgroundTint="@color/card_bg"
                android:text="🔋 Bateria"
                android:textColor="@color/text_primary" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
